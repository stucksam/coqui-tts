#!/bin/bash
#SBATCH --time=1440
#SBATCH --job-name=run_tts_resubmit_stku
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:2
#SBATCH --cpus-per-task=12
#SBATCH --nodelist=trinity
#SBATCH --mem=64G
#SBATCH --account=cai_nlp
#SBATCH --partition=gpu_top
#SBATCH --mail-user=stku@zhaw.ch
#SBATCH --output=/cluster/home/stku/log/%j_%N__run_re-rotation_stku.out
#SBATCH --error=/cluster/home/stku/log/%j_%N__run_re-rotation_stku.err
#SBATCH --signal=B:SIGUSR1@60

# ----------------------------------------------------------------------------------
# Prepare directories
# ----------------------------------------------------------------------------------
HOME_DIR_PATH="/cluster/home/stku/coqui-tts"
SUBMIT_FILE_PATH="$HOME_DIR_PATH/resubmit.submit"
SCRATCH_DIR_PATH="/scratch/subsets/"

if [ ! -d "$SCRATCH_DIR_PATH" ]; then
    mkdir -p "$SCRATCH_DIR_PATH"
fi

# ----------------------------------------------------------------------------------
# Stop signal handler
# ----------------------------------------------------------------------------------

# The --signal option specifies a signal to be sent to the job under certain conditions.
# In this case, we define "--signal=B:SIGUSR1@60"
# B: refers to the batch script itself, meaning the signal will be sent to the script running the job.
# SIGUSR1 is a user-defined signal
# @60 specifies the timing, indicating that the signal will be sent 60 seconds before the job's allocated time ends.
#
# 60 s was selected for the demo. In practice, you may want to set this to a much higher value, giving your job enough time to
# copy relevant files back to the storage cluster before the job is killed.
# - more to signals  here: https://manpages.ubuntu.com/manpages/kinetic/man7/signal.7.html
# - and Slurm specifics here: https://slurm.schedmd.com/sbatch.html

sig_handler_USR1()
{
    echo "++++++++++++++++++++++++++++++++++++++"
    echo "STOP SIGNAL DETECTED -  `date`"
    echo "++++++++++++++++++++++++++++++++++++++"
    echo "Current Subset: $subset"
    echo "Current epoch: $current_epoch"
    echo "Restarting training..."

    sleep 1
    sbatch $SUBMIT_FILE_PATH $subset $current_epoch
    sleep 1
    exit 0
}

# here we link the function "sig_handler_USR1" with the USR1 signal
# once the signal is received, the function sig_handler_USR1 will be executed
trap 'sig_handler_USR1' USR1

# ----------------------------------------------------------------------------------
# print executing hostname and date
# ----------------------------------------------------------------------------------
hostname

# ----------------------------------------------------------------------------------
# create python venv
# ----------------------------------------------------------------------------------
env_name="coqui-tts"
venv_base_dir="/raid/persistent_scratch/stku/venvs"
venv_path="$venv_base_dir/$env_name"

mkdir -p $venv_base_dir

# If venv does not yet exist, create it.
if [ -d "$venv_path" ]; then
    echo "Virtual environment ($env_name) found. Activating..."
    source "$venv_path/bin/activate"
else
    echo "Virtual environment ($env_name) not found. Creating..."
    module load python/3.11.9
    virtualenv $venv_path
    unset PIP_TARGET
    unset PYTHONPATH
    source "$venv_path/bin/activate"

    pip3 install -e .[all,dev,notebooks]
    pip3 install wandb h5py openpyxl
fi
# see https://github.com/pytorch/pytorch/issues/111469
export LD_LIBRARY_PATH=$venv_path/lib64/python3.11/site-packages/nvidia/nvjitlink/lib:$LD_LIBRARY_PATH

# ----------------------------------------------------------------------------------
# Setup variables
# ----------------------------------------------------------------------------------
NUMBER_OF_H5_SUBSETS=8 # You must define this somewhere
WANDB_LOGGER_ID=18670209 # You must define this somewhere
XTTS_RELOAD=true
subset=0 # this MUST be updated on restart
current_epoch=2 # this MUST be updated on restart


if [ ! -d "$DIR" ]; then
    mkdir -p "$DIR"
fi

# Check if one argument was provided
if [ $# -eq 0 ]; then
  echo "No arguments provided."
else
  echo "Argument provided, start training anew from subset $1 and epoch $2"
  sleep 1
  subset=$1
  current_epoch=$2
fi

# ----------------------------------------------------------------------------------
# copy first subset from projects dir to scratch
# ----------------------------------------------------------------------------------
python3 copy_subset.py $subset

# ----------------------------------------------------------------------------------
# Start training loop
# ----------------------------------------------------------------------------------
while true; do
    echo "Training on subset: $subset"

    # ----------------------------------------------------------------------------------
    # save training regiment that python can load. Important as distributed learning
    # makes passing params difficult
    # ----------------------------------------------------------------------------------
    cat <<EOF > xtts_config.json
{
  "subset": $subset,
  "epoch": $current_epoch,
  "xtts_reload": $XTTS_RELOAD,
  "total_num_subsets": $NUMBER_OF_H5_SUBSETS,
  "wandb_id": "$WANDB_LOGGER_ID"
}
EOF

    # ----------------------------------------------------------------------------------
    # calculate next subset and epoch based on total number of subsets
    # ----------------------------------------------------------------------------------
    if (( subset + 1 == NUMBER_OF_H5_SUBSETS )); then
        next_subset=0
        current_epoch=$((current_epoch + 1))
    else
        next_subset=$((subset + 1))
    fi

    # ----------------------------------------------------------------------------------
    # copy next subset from projects dir to scratch in background, so that training may
    # already start
    # ----------------------------------------------------------------------------------
    python3 copy_subset.py $next_subset &
    bg_pid=$!

    # ----------------------------------------------------------------------------------
    # train
    # ----------------------------------------------------------------------------------
    python3 -m trainer.distribute \
        --script recipes/ljspeech/xtts_v2/train_gpt_xtts_rotation.py \
        --gpus 0,1

    # ----------------------------------------------------------------------------------
    # If copy job still in progress of next subset, wait. Afterwards remove previous
    # subset so that scratch is not filled and set important params
    # ----------------------------------------------------------------------------------
    wait $bg_pid
    python3 remove_subset.py $subset

    subset=$next_subset

    if [ "$XTTS_RELOAD" = false ]; then
        XTTS_RELOAD=true
    fi
done
